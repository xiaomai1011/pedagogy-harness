[Unit]
Description=ph-judge-agent（VM 内判题 agent：只转发内置固定样例，不执行代码）
After=network.target ph-judge-worker.service
Wants=ph-judge-worker.service

[Service]
Type=simple
User=phagent
Group=phagent
SupplementaryGroups=ph-judge
ExecStart=/usr/bin/python3 /opt/ph-judge-agent/ph_judge_agent.py --bind 192.168.200.10 --port 9443 --token-file /etc/ph-judge-agent/token
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/ph-judge-agent
ReadWritePaths=/run/ph-judge
Environment=PH_WORKER_SOCKET=/run/ph-judge/worker.sock
