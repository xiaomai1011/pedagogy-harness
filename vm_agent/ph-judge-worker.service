[Unit]
Description=ph-judge-worker（phcode 身份，只执行内置样例与已登记固定请求）
After=network.target
Before=ph-judge-agent.service

[Service]
Type=simple
User=phcode
Group=phcode
SupplementaryGroups=ph-judge
WorkingDirectory=/var/lib/ph-code
# 题目（含隐藏用例期望输出）由 root 预拷进 0700 目录，worker 启动读入内存后删除磁盘副本；
# 执行期间磁盘上不存在答案，学生代码拿不到。
ExecStartPre=+/usr/bin/install -d -o phcode -g phcode -m 0700 /run/ph-judge/questions
ExecStartPre=+/usr/bin/install -o phcode -g phcode -m 0400 /etc/ph-judge-agent/p001.json /run/ph-judge/questions/P001.json
ExecStart=/usr/bin/python3 /opt/ph-judge-agent/ph_judge_worker.py --socket /run/ph-judge/worker.sock
Restart=on-failure
RestartSec=3

# 身份与权限边界：不提升权限、看不到 /home、系统目录只读
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/ph-judge

# 资源与网络上限（cgroup）：无 IPv4/IPv6 出口，只能走 Unix socket
IPAddressDeny=any
MemoryMax=512M
CPUQuota=100%
TasksMax=48

Environment=PH_WORK_ROOT=/run/ph-judge/work
Environment=PH_WORKER_SOCKET=/run/ph-judge/worker.sock
Environment=PH_QUESTIONS_DIR=/run/ph-judge/questions
Environment=PH_REQUESTS_FILE=/opt/ph-judge-agent/p001_requests.json
