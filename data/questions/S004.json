  "reference_solution": "import sys\ndata = list(map(int, sys.stdin.buffer.read().split()))\nn = data[0]\nk = 60\nvalues = data[1:]\nlow = equal = high = 0\nfor x in values:\n    if x < k:\n        low += 1\n    elif x == k:\n        equal += 1\n    else:\n        high += 1\nprint(low, equal, high)\n",
