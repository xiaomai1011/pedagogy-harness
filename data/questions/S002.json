  "reference_solution": "import sys\ndata = list(map(int, sys.stdin.buffer.read().split()))\nactive = False\ntotal = 0\nfor x in data[1:]:\n    if x == 8:\n        active = True\n    elif active and x == 9:\n        active = False\n    elif not active:\n        total += x\nprint(total)\n",
