  "reference_solution": "import sys\ndata = sys.stdin.read().split()\nn = int(data[0])\nwins = {('0', '2'), ('2', '5'), ('5', '0')}\nwin_a = win_b = 0\nfor i in range(n):\n    a, b = data[1 + 2*i:3 + 2*i]\n    if a == b:\n        continue\n    if (a, b) in wins:\n        win_a += 1\n    else:\n        win_b += 1\nprint(\"A\" if win_a > win_b else \"B\" if win_b > win_a else \"draw\")\n",
