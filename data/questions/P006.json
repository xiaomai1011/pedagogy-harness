{
  "id": "P006",
  "title": "从小到大排序输出",
  "statement": "【题目描述】\n给出 n 个整数，把它们按**从小到大**排序后输出。\n\n【输入格式】\n第一行一个整数 n。\n\n第二行 n 个整数，用空格分隔。\n\n【输出格式】\n一行，排序后的 n 个整数，用空格分隔。\n\n【说明/提示】\n- **数据范围**：1 ≤ n ≤ 100，|a_i| ≤ 10^4。\n- 输入可能包含重复的数。",
  "examples": [
    {
      "input": "4\n3 1 4 2",
      "output": "1 2 3 4"
    },
    {
      "input": "1\n7",
      "output": "7"
    }
  ],
  "test_cases": [
    {
      "input": "4\n3 1 4 2",
      "expected": "1 2 3 4",
      "hidden": false
    },
    {
      "input": "1\n7",
      "expected": "7",
      "hidden": false
    },
    {
      "input": "6\n10 2 5 10 3 1",
      "expected": "1 2 3 5 10 10",
      "hidden": true
    },
    {
      "input": "3\n-1 -5 0",
      "expected": "-5 -1 0",
      "hidden": true
    },
    {
      "input": "5\n100 -100 0 50 -50",
      "expected": "-100 -50 0 50 100",
      "hidden": true
    }
  ],
  "reference_solution": "n = int(input())\na = list(map(int, input().split()))\n\na.sort()\nprint(\" \".join(map(str, a)))\n",
  "knowledge_points": [
    "列表",
    "排序"
  ],
  "difficulty": 1,
  "phase": "practice"
}
